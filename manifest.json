{
  "manifest_version": 3,
  "name": "SmartFill",
  "version": "1.0.0",
  "description": "AI-assisted quality control review for inspection reports.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.ezsurveyform.com/*",
    "https://dashboard.boost-usa.com/*",
    "http://localhost:4010/*"
  ],
  "action": {
    "default_title": "Open SmartFill",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ezsurveyform.com/cgi-bin/*"
      ],
      "js": [
        "content/snapshot.js",
        "content/writer.js",
        "content/overlay.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}